# Copy to .env and fill in. Never commit real secrets.
# Every value below is a placeholder.

# ---------------------------------------------------------------- core
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-only-secret-change-me
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# ------------------------------------------------------------ datastores
DATABASE_URL=postgresql+psycopg://jobapply:jobapply@postgres:5432/jobapply
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------ auth
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --------------------------------------------------------------- storage
# local = filesystem (no cloud account needed); s3 = any S3-compatible endpoint
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------- e-mail
# console = logged to stdout and kept in an in-process outbox
# smtp = delivered to the Mailpit container, readable at http://localhost:8025.
# console = printed to the API's own output, for running without Docker.
EMAIL_BACKEND=smtp
EMAIL_FROM=no-reply@jobapply.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# -------------------------------------------------------------------- ai
# mock = deterministic local provider, no API key and no network required
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=60

# ------------------------------------------------------------ automation
# Caps protect the user from runaway automation and account problems.
# They are never used to work around an employer's own rate limits.
AUTOMATION_DAILY_LIMIT=25
AUTOMATION_HOURLY_LIMIT=5
AUTOMATION_MIN_DELAY_SECONDS=45
AUTOMATION_MAX_DELAY_SECONDS=180
AUTOMATION_MIN_MATCH_SCORE=70
CONFIDENCE_AUTO_THRESHOLD=0.95
CONFIDENCE_REVIEW_THRESHOLD=0.80
BROWSER_HEADLESS=true

# --------------------------------------------------------------- billing
BILLING_BACKEND=noop
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -------------------------------------------------------------- frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
